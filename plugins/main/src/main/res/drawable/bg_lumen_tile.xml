<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen stat tile: subtle elevated surface with a hairline border.
     Uses translucent white/grey so it works on both light and dark themes
     without depending on cross-module color resources. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="#14FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#22888888" />
</shape>
